# ── Frontend ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# ── Backend ───────────────────────────────────────────────────────────────────
backend/target/
backend/.quarkus/
backend/src/main/docker/*.jar
*.class
*.jar
!**/test-lib/*.jar

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.DS_Store
Thumbs.db
desktop.ini

# ── Local agent tooling ───────────────────────────────────────────────────────
# Machine-specific state: caches git fingerprints and embeds absolute local
# paths (e.g. C:\Users\<you>\.config\...). Never belongs in the repo.
.atl/
.agents/
.claude/settings.local.json
.opencode/

# ── TLS / mTLS certificates (generated by scripts/generate-tls-certs.*) ──────
*.crt
*.key
!package-lock.json
certs/

# ── Maven wrapper ─────────────────────────────────────────────────────────────
.mvn/wrapper/maven-wrapper.jar

# ── Quarkus dev ───────────────────────────────────────────────────────────────
backend/.quarkus/dev/

# ── Media uploads (local dev) ─────────────────────────────────────────────────
uploads/

# ── CodeGraph index ───────────────────────────────────────────────────────────
# NOTE: .codegraph/ self-manages via its own committed .codegraph/.gitignore,
# which keeps the SQLite index ignored while tracking the sentinel file. Do NOT
# add a blanket .codegraph/ rule here — it would untrack that sentinel.

# ── Logs & OS noise ───────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Docker volumes / local data ───────────────────────────────────────────────
.docker-data/

# ── Env files ─────────────────────────────────────────────────────────────────
# Only .env.example is committed. These patterns have no slash, so they match at
# ANY depth (root .env, frontend/.env, frontend/.env.production, ...).
.env
.env.*
!.env.example
!.env.prod.example

# ── Secrets: JWT keypair ──────────────────────────────────────────────────────
# BOTH halves are generated per-developer (RSA-2048). Committing only the
# public key is actively harmful: a fresh clone would ship a verifier for a
# key nobody holds, and the matching private key sits on whoever ran the
# generator. Ignore both, regenerate on clone.
backend/dev-keys/privateKey.pem
backend/dev-keys/publicKey.pem
# Legacy location (pre-dev-keys): keep ignored so stale local copies can never
# be committed, even though the generator no longer writes them.
backend/src/main/resources/META-INF/resources/*.pem

# The SAME keypair is also written to secrets/ on the host, which
# docker-compose.yml bind-mounts read-only into the backend at
# /deployments/config. Ignore the contents but keep the directory itself
# tracked: Docker silently auto-creates a missing bind-mount source as a
# root-owned empty directory, so the mount "succeeds" while the container sees
# no keys — a confusing failure worth spending a sentinel file to prevent.
# scripts/generate-jwt-keys.sh writes the .pem files in.
secrets/*
!secrets/.gitkeep

# ── Secrets: Web Push / VAPID (Phase 7) ──────────────────────────────────────
# Preventive: the VAPID private key is env-only today, but never let it land
# on disk in a tracked path.
vapid-private.key
*.vapid.key
*.vapid.pem
.codegraph
comando.md

Entregable_Seguimiento.md
