# Copy to .env on the production server. Do not commit .env.
# Exact browser origins, without a trailing slash. Use HTTPS URLs if an
# external TLS proxy is configured; direct published ports use HTTP.
APP_ORIGIN=http://YOUR_SERVER:3000
RUSTFS_PUBLIC_ENDPOINT=http://YOUR_SERVER:9000

# Set to the UID/GID of the Linux user that owns secrets/privateKey.pem.
# Run `id -u` and `id -g` on the server; never use root (0).
APP_UID=
APP_GID=

# Use unique, strong credentials. Keep NEO4J_USER fixed as neo4j.
NEO4J_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=red-social
AWS_REGION=us-east-1

# Run `node scripts/generate-vapid-keys.mjs` once after creating .env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
