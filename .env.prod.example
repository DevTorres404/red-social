# Copy to .env on the production server. Do not commit .env.
# Public Cloudflare Tunnel hostnames; exact HTTPS origins, no trailing slash.
# Host cloudflared: orbit.labtorres.me -> http://127.0.0.1:3000
#                   media.orbit.labtorres.me -> http://127.0.0.1:9000
APP_ORIGIN=https://orbit.labtorres.me
RUSTFS_PUBLIC_ENDPOINT=https://media.orbit.labtorres.me

# Set to the UID/GID of the Linux user that owns secrets/privateKey.pem.
# Run `id -u` and `id -g` on the server; never use root (0).
APP_UID=
APP_GID=

# Use unique, strong credentials. Keep NEO4J_USER fixed as neo4j.
NEO4J_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=red-social
AWS_REGION=us-east-1

# Run `node scripts/generate-vapid-keys.mjs` once after creating .env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
