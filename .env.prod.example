# Copy to .env on the production server. Do not commit .env.
# Both DNS A/AAAA records must point to this server before startup.
APP_DOMAIN=
MEDIA_DOMAIN=

# Set to the UID/GID of the Linux user that owns secrets/privateKey.pem.
# Run `id -u` and `id -g` on the server; never use root (0).
APP_UID=
APP_GID=

# Use unique, strong credentials. Keep NEO4J_USER fixed as neo4j.
NEO4J_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=red-social
AWS_REGION=us-east-1

# Run `node scripts/generate-vapid-keys.mjs` once after creating .env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
