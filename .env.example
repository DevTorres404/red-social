# ══════════════════════════════════════════════════════════════════════════════
#  TEMPLATE — copy to .env and fill in real values:
#      cp .env.example .env
#  Never commit .env. Only this template is tracked.
# ══════════════════════════════════════════════════════════════════════════════

# ── Neo4j ─────────────────────────────────────────────────────────────────────
# Consumed by docker-compose.yml only. The service endpoint is hardcoded to the
# in-network address (bolt://neo4j:7687), so there is no URI knob here.
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── MinIO (S3-compatible) ─────────────────────────────────────────────────────
# The S3 endpoint is hardcoded to http://minio:9000 in compose.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=red-social
# Browser-reachable endpoint used only to sign short-lived image reads.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
WEBSOCKET_ALLOWED_ORIGIN=http://localhost:3000

# ── AWS region ────────────────────────────────────────────────────────────────
# Region only. Credentials are NOT read from the AWS env chain: Quarkus is
# configured with a static-credentials provider, which takes precedence and is
# fed from MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above.
AWS_REGION=us-east-1

# ── JWT key material ──────────────────────────────────────────────────────────
# CONTAINER paths. The keypair is generated per-developer and never committed —
# run ./scripts/generate-jwt-keys.sh before the first `docker compose up`.
# That script writes secrets/{private,public}Key.pem on the host and bind-mounts
# secrets/ read-only at /deployments/config, which is where these paths point.
SMALLRYE_JWT_SIGN_KEY_LOCATION=/deployments/config/privateKey.pem
MP_JWT_VERIFY_PUBLICKEY_LOCATION=/deployments/config/publicKey.pem

JWT_SECRET=change-me-in-production-min-256-bits

# ── Web Push VAPID keys ───────────────────────────────────────────────────────
# Generate once with: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@redsocial.dev

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
