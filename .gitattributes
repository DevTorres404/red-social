# Auto-detect text files and normalize to LF in the repo
* text=auto eol=lf

# Force LF for specific file types
*.java        text eol=lf
*.jsx         text eol=lf
*.js          text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.xml         text eol=lf
*.properties  text eol=lf
*.md          text eol=lf
*.sh          text eol=lf
Dockerfile*   text eol=lf
*.conf        text eol=lf

# Binary files — no line-ending conversion
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.svg         binary
*.ico         binary
*.jar         binary
*.zip         binary
